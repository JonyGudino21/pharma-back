// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id       Int     @id @default(autoincrement())
  name     String
  email    String? @unique
  phone    String?
  address  String?
  rfc      String?
  curp     String?
  isActive Boolean @default(true)

  // Configuración de Crédito
  hasCredit   Boolean @default(false)
  creditLimit Decimal @default(0) @db.Decimal(12, 2)
  currentDebt Decimal @default(0) @db.Decimal(12, 2) // Campo calculado/caché para velocidad

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales               Sale[]
  productPrice        ClientProductPrice[]
  productPriceHistory ClientProductPriceHistory[]

  @@index([name])
  @@index([rfc])
  @@index([phone])
  @@index([email])
}

model Product {
  id Int @id @default(autoincrement())

  name         String
  description  String?
  sku          String      @unique // Código interno
  barcode      String?     @unique
  controlled   Boolean     @default(false) // Medicamento controlado
  strength     String? // 500mg, 1000mg
  format       String? // Tableta, Capsula
  presentation String? // Adulto, Infantil
  stock        Int         @default(0)
  minStock     Int         @default(5)
  price        Decimal     @db.Decimal(10, 2) // Precio de VENTA al público
  cost         Decimal     @db.Decimal(10, 2) // Costo promedio actual
  // Tratamiento de IVA. El precio de venta es SIEMPRE con IVA incluido (LFPC
  // art. 7 Bis): el impuesto se desglosa hacia dentro. ZERO por defecto porque
  // el grueso del catálogo son medicinas (LIVA art. 2o.-A); perfumería,
  // refrescos, jugos y chicles deben marcarse GENERAL.
  taxCategory  TaxCategory @default(ZERO)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación muchos a muchos con categorías
  categories ProductCategory[]

  saleItems          SaleItem[]
  priceHistory       ProductPriceHistory[]
  purchaseItems      PurchaseItem[]
  clientPrice        ClientProductPrice[]
  clientPriceHistory ClientProductPriceHistory[]
  movements          InventoryMovement[]
  batches            ProductBatch[]
  controlledLogs     ControlledSaleLog[]

  @@index([name])
  @@index([sku])
  @@index([barcode])
  @@index([controlled])
}

model ProductPriceHistory {
  id Int @id @default(autoincrement())

  product     Product @relation(fields: [productId], references: [id])
  productId   Int
  changedBy   User?   @relation(fields: [changedById], references: [id])
  changedById Int?

  price     Decimal   @db.Decimal(10, 2)
  startDate DateTime  @default(now())
  endDate   DateTime?

  @@index([productId])
  @@index([startDate])
}

model Sale {
  id Int @id @default(autoincrement())

  client      Client?    @relation(fields: [clientId], references: [id])
  clientId    Int?
  user        User?      @relation(fields: [userId], references: [id])
  userId      Int?
  // Relación con Turno de Caja (CRÍTICO para cuadrar cajeros)
  cashShift   CashShift? @relation(fields: [cashShiftId], references: [id])
  cashShiftId Int?

  // Estado financiero REAL
  paymentStatus PaymentStatus @default(PENDING) // PENDING, PARTIAL, PAID

  total      Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  paidAmount Decimal @default(0) @db.Decimal(12, 2) // Cuánto han pagado
  balance    Decimal @default(0) @db.Decimal(12, 2) // Cuánto deben (Deuda)

  // Descuentos e impuestos. `subtotal` = suma bruta (precio × cantidad),
  // `total` = subtotal − discountTotal. El IVA va INCLUIDO en `total`.
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)

  // Snapshot de utilidad
  totalCost Decimal @default(0) @db.Decimal(12, 2) // Suma del costo de los items al momento de venta
  profit    Decimal @default(0) @db.Decimal(12, 2) // total - taxTotal - totalCost (sin IVA)

  invoiceNumber String?        @unique //AAA010101AAA202401000000001  Para CFDI 4.0 en México
  flowStatus    SaleFlowStatus @default(DRAFT)
  status        SaleStatus     @default(PENDING)
  paymentMethod PaymentMethod  @default(CASH)
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              SaleItem[]
  payments           SalePayment[]
  saleReturn         SaleReturn[]
  saleRefunds        SaleRefund[]
  receiptPrints      SaleReceiptPrint[]
  clientPriceChanges ClientProductPriceHistory[]
  controlledLogs     ControlledSaleLog[]

  @@index([createdAt])
  @@index([invoiceNumber])
  @@index([status])
  @@index([paymentMethod])
  @@index([cashShiftId])
  @@index([clientId])
  @@index([userId])
  @@index([flowStatus])
  // Recuperación del carrito en curso (GET /sales/draft). Corre en cada carga
  // del POS: sin el compuesto, filtrar por (userId, flowStatus) obligaba a
  // ordenar en memoria todo el histórico del cajero para devolver una fila.
  @@index([userId, flowStatus, createdAt])
}

model SaleItem {
  id Int @id @default(autoincrement())

  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int

  quantity Int
  price    Decimal @db.Decimal(10, 2) //Precio aplicado (con IVA)
  // Importe descontado de la línea (no por unidad). subtotal = price × qty − discount.
  discount Decimal @default(0) @db.Decimal(10, 2)
  subtotal Decimal @db.Decimal(10, 2)

  // Descuento auditado: qué porcentaje, por qué, quién lo aplicó y quién lo
  // autorizó si rebasaba el tope de su rol.
  discountPercent        Decimal @default(0) @db.Decimal(5, 2)
  discountReason         String?
  discountAppliedBy      User?   @relation("SaleItemDiscountAppliedBy", fields: [discountAppliedById], references: [id])
  discountAppliedById    Int?
  discountAuthorizedBy   User?   @relation("SaleItemDiscountAuthorizedBy", fields: [discountAuthorizedById], references: [id])
  discountAuthorizedById Int?

  // Impuesto CONGELADO al vender: tasa efectiva (0.16, 0.08, 0) y monto
  // incluido en `subtotal`. Si mañana cambia la tasa, la venta de hoy no cambia.
  taxRate   Decimal @default(0) @db.Decimal(5, 4)
  taxAmount Decimal @default(0) @db.Decimal(10, 2)

  // Guardamos cuánto costaba este producto HOY para calcular ganancia histórica
  costAtSale Decimal @db.Decimal(10, 2)

  // ORIGEN DEL PRECIO (ADR-0025). `listPrice` es el precio de lista del producto
  // cuando se agregó la línea: la referencia para mostrar "precio especial" y
  // auditar cuánto se movió. `priceSource`: LIST (de lista), CLIENT (precio
  // especial del cliente) o MANUAL (lo cambió alguien en caja: quién y por qué).
  listPrice        Decimal?        @db.Decimal(10, 2)
  priceSource      SalePriceSource @default(LIST)
  priceChangedBy   User?           @relation("SaleItemPriceChangedBy", fields: [priceChangedById], references: [id])
  priceChangedById Int?
  priceReason      String?

  batches SaleItemBatch[]

  // Una sola línea por producto dentro de una venta.
  // Habilita el upsert atómico de addItem: sin esta restricción, dos escaneos
  // simultáneos del mismo producto creaban dos líneas y se perdían unidades.
  @@unique([saleId, productId])
  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id Int @id @default(autoincrement())

  sale   Sale @relation(fields: [saleId], references: [id])
  saleId Int

  method     PaymentMethod
  amount     Decimal       @db.Decimal(12, 2)
  references String?

  // Si es en efectivo, ¿a qué caja entró?
  cashShiftId Int?
  isDeposit   Boolean @default(true) // true = Pago, false = Reembolso

  // Clave de idempotencia enviada por el cliente (header Idempotency-Key).
  // Si una respuesta se pierde y el cajero reintenta, el UNIQUE impide un
  // segundo cobro: el reintento devuelve el pago ya registrado.
  // Nullable para no romper los pagos históricos ni los abonos internos.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([method])
  // Lo usa el `aggregate` de CADA cierre de caja para sumar el efectivo del
  // turno. Sin índice, cerrar caja recorre todos los pagos históricos.
  @@index([cashShiftId])
}

model SaleReturn {
  id Int @id @default(autoincrement())

  sale          Sale  @relation(fields: [saleId], references: [id])
  saleId        Int
  processedBy   User? @relation(fields: [processedById], references: [id])
  processedById Int?

  note String?

  createdAt DateTime @default(now())

  items  SaleReturnItem[]
  refund SaleRefund[]

  @@index([saleId])
}

model SaleReturnItem {
  id Int @id @default(autoincrement())

  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id])
  saleReturnId Int

  saleItemId Int
  productId  Int
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  reason     String?

  @@index([saleItemId])
  @@index([saleReturnId])
}

model SaleRefund {
  id Int @id @default(autoincrement())

  // SIN @unique desde v1: una devolución de una venta pagada con varios medios
  // (parte tarjeta, parte efectivo) genera UN reembolso POR MEDIO. Con el
  // UNIQUE sólo cabía uno y todo se reembolsaba en efectivo, sacando del cajón
  // dinero que había entrado por la terminal. La relación ya estaba declarada
  // como lista (`SaleReturn.refund SaleRefund[]`); ahora la base coincide.
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id])
  saleReturnId Int
  sale         Sale       @relation(fields: [saleId], references: [id])
  saleId       Int

  amount    Decimal        @db.Decimal(12, 2)
  method    PaymentMethod?
  reference String?

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([saleReturnId])
}

//TODO: Registrar el vuelto en un futuro: CashMovement, CashMovementType, CashMovementCategory 

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación muchos a muchos con productos
  products ProductCategory[]

  @@unique([name])
  @@index([isActive])
}

// Tabla intermediaria para la relación muchos a muchos entre Product y Category
model ProductCategory {
  id Int @id @default(autoincrement())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int

  // Campos adicionales opcionales
  isPrimary Boolean @default(false) // Categoría principal del producto
  order     Int? // Orden de importancia de la categoría

  createdAt DateTime @default(now())

  @@unique([productId, categoryId]) // Evita duplicados
  @@index([productId])
  @@index([categoryId])
  @@index([isPrimary])
}

model User {
  id Int @id @default(autoincrement())

  userName  String   @unique
  password  String
  email     String   @unique
  firstName String
  lastName  String
  role      UserRole
  isActive  Boolean  @default(true)

  sale                      Sale[]
  productPriceHistory       ProductPriceHistory[]
  clientProductPriceHistory ClientProductPriceHistory[]
  token                     UserToken[]
  saleReturn                SaleReturn[]
  cashData                  CashShift[]
  saleReceiptPrints         SaleReceiptPrint[]
  controlledSaleLogs        ControlledSaleLog[]
  settingsUpdated           AppSetting[]                @relation("AppSettingUpdatedBy")
  settingsChanges           AppSettingAudit[]           @relation("AppSettingAuditChangedBy")
  discountsApplied          SaleItem[]                  @relation("SaleItemDiscountAppliedBy")
  discountsAuthorized       SaleItem[]                  @relation("SaleItemDiscountAuthorizedBy")
  pricesChanged             SaleItem[]                  @relation("SaleItemPriceChangedBy")
  cashDrawerEvents          CashDrawerEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userName])
  @@index([email])
}

// Ajustes de operación, UNA fila por sección ("inventory", "cash").
//
// El contenido (`value`) se valida en código contra la definición tipada de
// cada sección (src/settings/definitions). Así, agregar un ajuste nuevo es
// agregar un campo con su valor por defecto: sin migración.
//
// `version` es el bloqueo optimista: dos gerentes editando a la vez no se
// pisan en silencio; el segundo recibe 409 y recarga.
model AppSetting {
  namespace String @id
  value     Json
  version   Int    @default(1)

  updatedBy   User? @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id])
  updatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bitácora INMUTABLE de cambios de configuración: una fila por ajuste cambiado.
// La tolerancia del arqueo o el criterio de caducidad son controles
// antifraude y sanitarios: "quién lo cambió y cuándo" tiene que poder
// responderse en una auditoría.
model AppSettingAudit {
  id        Int    @id @default(autoincrement())
  namespace String
  key       String
  oldValue  Json?
  newValue  Json

  changedBy   User     @relation("AppSettingAuditChangedBy", fields: [changedById], references: [id])
  changedById Int
  changedAt   DateTime @default(now())

  @@index([namespace, changedAt])
}

// Una sola empresa por instalación. `singletonKey` impide que un GET
// concurrente al primer arranque cree dos fichas fiscales.
model Company {
  id           Int    @id @default(autoincrement())
  singletonKey String @unique @default("default")

  legalName    String
  tradeName    String
  rfc          String  @default("")
  fiscalRegime String?
  address      String  @default("")
  phone        String?
  email        String?
  logoUrl      String?
  ticketFooter String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates ReceiptTemplate[]
}

model ReceiptTemplate {
  id        Int     @id @default(autoincrement())
  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  name         String
  paperWidthMm Int     @default(58)
  showLogo     Boolean @default(true)
  showTaxId    Boolean @default(true)
  showAddress  Boolean @default(true)
  showPhone    Boolean @default(true)
  fontScale    Int     @default(1)
  layout       Json
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prints SaleReceiptPrint[]

  @@index([companyId, isDefault])
  @@index([companyId, isActive])
}

// Cada pulso de "Imprimir" deja rastro. copyNumber 1 = original, 2+ = copia.
model SaleReceiptPrint {
  id          Int              @id @default(autoincrement())
  sale        Sale             @relation(fields: [saleId], references: [id])
  saleId      Int
  printedBy   User             @relation(fields: [printedById], references: [id])
  printedById Int
  template    ReceiptTemplate? @relation(fields: [templateId], references: [id])
  templateId  Int?

  document   PrintDocument @default(TICKET)
  copyNumber Int
  channel    PrintChannel
  printedAt  DateTime      @default(now())

  @@unique([saleId, document, copyNumber])
  @@index([saleId])
  @@index([printedById])
}

model Supplier {
  id       Int     @id @default(autoincrement())
  name     String
  contact  String?
  phone    String?
  email    String? @unique
  isActive Boolean @default(true)

  creditDays Int     @default(0) // Días de crédito (Ej. 30)
  balance    Decimal @default(0) @db.Decimal(12, 2) // Cuánto le debemos nosotros

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([email])
}

model Purchase {
  id Int @id @default(autoincrement())

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId Int

  invoiceNumber String //folio de la factura
  total         Decimal @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)
  paidAmount    Decimal @default(0) @db.Decimal(12, 2) // Cuánto hemos abonado
  balance       Decimal @default(0) @db.Decimal(12, 2) // Cuánto falta pagar (Deuda)

  status PurchaseStatus @default(PENDING) // estado del pago

  // Define si la mercancía ya entró al almacén o es solo un pedido
  deliveryStatus PurchaseDeliveryStatus @default(PENDING)

  items    PurchaseItem[]
  payments PurchasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deliveryStatus])
  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseItem {
  id Int @id @default(autoincrement())

  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  purchaseId Int
  product    Product  @relation(fields: [productId], references: [id])
  productId  Int

  quantity Int
  cost     Decimal @db.Decimal(10, 2) // Precio de COMPRA real de este lote
  subtotal Decimal @db.Decimal(12, 2)

  // Lote del fabricante. Obligatorio al recibir un controlado; opcional en el resto
  // para no bloquear insumos sin caducidad (bolsas, material de curación).
  lotNumber  String?
  expiryDate DateTime? @db.Date

  batches ProductBatch[]

  @@index([purchaseId])
  @@index([productId])
}

model PurchasePayment {
  id Int @id @default(autoincrement())

  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  purchaseId Int

  method     PaymentMethod
  amount     Decimal       @db.Decimal(10, 2)
  references String?

  createdAt DateTime @default(now())

  @@index([purchaseId])
  @@index([method])
}

model ClientProductPrice {
  id Int @id @default(autoincrement())

  client    Client  @relation(fields: [clientId], references: [id])
  clientId  Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int

  price    Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([clientId, productId])
  @@index([clientId])
  @@index([productId])
}

model ClientProductPriceHistory {
  id Int @id @default(autoincrement())

  client      Client  @relation(fields: [clientId], references: [id])
  clientId    Int
  product     Product @relation(fields: [productId], references: [id])
  productId   Int
  changedBy   User    @relation(fields: [changedById], references: [id])
  changedById Int

  price         Decimal  @db.Decimal(10, 2)
  // Auditoría del cambio (ADR-0025): precio anterior (null = no tenía precio
  // especial), motivo, y la venta desde la que se cambió (null = desde la ficha
  // del cliente).
  previousPrice Decimal? @db.Decimal(10, 2)
  reason        String?
  sale          Sale?    @relation(fields: [saleId], references: [id])
  saleId        Int?

  startDate DateTime  @default(now())
  endDate   DateTime?

  @@index([clientId, productId])
}

/// De dónde salió el precio de una línea de venta (ADR-0025).
enum SalePriceSource {
  LIST // precio de lista del producto
  CLIENT // precio especial vigente del cliente
  MANUAL // cambiado en caja por un usuario
}

model UserToken {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  // sha256 del refresh token. El token en claro NUNCA se persiste: un dump de
  // esta tabla no debe entregar sesiones usables. Ver TokenService.
  tokenHash  String    @unique
  type       TokenType @default(REFRESH)
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime?
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sin @@index([tokenHash]): la columna ya es @unique y Postgres crea su propio
  // índice. El índice extra que existía sobre `token` sólo duplicaba el B-tree y
  // encarecía cada rotación.
  @@index([userId])
  @@index([expiresAt])
}

model CashShift {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  // Control de tiempos
  openedAt DateTime  @default(now())
  closedAt DateTime?

  // Control de dinero
  initialAmount  Decimal  @db.Decimal(12, 2) // Fondo de caja inicial
  expectedAmount Decimal? @db.Decimal(12, 2) // Calculado por el sistema al cerrar
  realAmount     Decimal? @db.Decimal(12, 2) // Lo que el cajero contó físicamente (Cierre ciego)
  difference     Decimal? @db.Decimal(12, 2) // real - expected (Positivo sobra, Negativo falta)

  status ShiftStatus @default(OPEN)

  notes String?

  transactions CashTransaction[] // Movimientos de dinero (Entradas/Salidas/Ventas)
  drawerEvents CashDrawerEvent[] // Aperturas del cajón SIN venta (auditadas)
  sales        Sale[] // Ventas ligadas a este turno

  @@index([userId])
  @@index([status])
  @@index([openedAt])
}

model CashTransaction {
  id Int @id @default(autoincrement())

  shift   CashShift @relation(fields: [shiftId], references: [id])
  shiftId Int

  type   CashTransactionType // INGRESO, EGRESO, CORTE
  amount Decimal             @db.Decimal(12, 2)
  reason String // "Retiro por exceso de efectivo", "Pago de luz caja chica"

  referenceId  Int? // ID opcional si viene de una Venta o Compra
  relatedTable String? // "Sale", "Purchase"

  createdAt DateTime @default(now())
  createdBy Int // User ID

  @@index([shiftId])
}

model InventoryMovement {
  id Int @id @default(autoincrement())

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  type     MovementType
  quantity Int // Positivo (Entrada), Negativo (Salida)

  // Snapshot financiero: ¿Cuánto valía esto cuando se movió?
  unitCost  Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(12, 2)

  // Trazabilidad
  reason      String // "Venta #123", "Merma", "Compra #55"
  referenceId Int? // ID de Venta, Compra o Ajuste

  createdAt DateTime @default(now())
  createdBy Int // User ID

  batch   ProductBatch? @relation(fields: [batchId], references: [id])
  batchId Int?

  @@index([productId])
  @@index([createdAt])
  @@index([type])
  @@index([batchId])
}

// Existencia física desglosada por lote/caducidad. Product.stock sigue siendo
// el total cacheado (mutación atómica); la suma de lotes + residual sin lote
// debe coincidir. Nunca se recalcula el total como SUM en caliente: eso
// reintroduce el read-modify-write que P0-1 cerró.
model ProductBatch {
  id         Int      @id @default(autoincrement())
  // Restrict, NO Cascade: un lote es un registro financiero y regulatorio.
  // Con Cascade, un borrado físico de producto destruiría los lotes y dejaría
  // en NULL el batchId de los asientos del libro de controlados, anulando la
  // trazabilidad exigida en una inspección. Hoy el borrado es lógico
  // (isActive = false), así que esto sella una mina latente.
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId  Int
  lotNumber  String
  expiryDate DateTime @db.Date
  quantity   Int      @default(0)
  cost       Decimal  @db.Decimal(10, 2)
  receivedAt DateTime @default(now())

  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId Int?

  saleItemBatches SaleItemBatch[]
  movements       InventoryMovement[]
  controlledLogs  ControlledSaleLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, lotNumber])
  @@index([productId, expiryDate])
  @@index([expiryDate])
}

// Cuántas unidades de cada lote salieron en una línea de venta (split FEFO).
model SaleItemBatch {
  id         Int          @id @default(autoincrement())
  saleItem   SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  saleItemId Int
  batch      ProductBatch @relation(fields: [batchId], references: [id])
  batchId    Int
  quantity   Int

  @@unique([saleItemId, batchId])
  @@index([saleItemId])
  @@index([batchId])
}

// Libro de controlados COFEPRIS: bitácora append-only. Nunca se borra una fila;
// una devolución o destrucción se registra con otro entryType.
model ControlledSaleLog {
  id        Int                    @id @default(autoincrement())
  entryType ControlledLogEntryType @default(DISPENSE)

  sale      Sale?         @relation(fields: [saleId], references: [id])
  saleId    Int?
  product   Product       @relation(fields: [productId], references: [id])
  productId Int
  batch     ProductBatch? @relation(fields: [batchId], references: [id])
  batchId   Int?

  quantity       Int
  prescriptionNo String?
  doctorName     String?
  doctorLicense  String?
  patientName    String?

  soldBy   User @relation(fields: [soldById], references: [id])
  soldById Int

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([prescriptionNo])
  @@index([doctorLicense])
  @@index([saleId])
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum MovementType {
  INITIAL // Saldo inicial al crear producto
  SALE // Salida por venta
  PURCHASE // Entrada por compra
  RETURN_IN // Entrada por devolución de cliente
  RETURN_OUT // Salida por devolución a proveedor
  ADJUSTMENT // Ajuste de inventario (Robo, Conteo)
  LOSS // Merma conocida (roto, caducado, robo confirmado) - Gasto
  TRANSFER // Movimiento entre sucursales (Futuro)
}

// Aperturas del cajón de dinero que NO vienen de un cobro en efectivo.
// "Abrir sin venta" es la vía clásica para sacar dinero sin rastro: cada una
// queda registrada con quién, cuándo, en qué caja y por qué.
model CashDrawerEvent {
  id       Int                 @id @default(autoincrement())
  kind     CashDrawerEventKind
  reason   String
  terminal String?

  user    User       @relation(fields: [userId], references: [id])
  userId  Int
  shift   CashShift? @relation(fields: [shiftId], references: [id])
  shiftId Int?

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([createdAt])
}

enum CashDrawerEventKind {
  MANUAL // Apertura manual (cambio, revisión)
  TEST // Prueba desde Configuración › Dispositivos
}

// Tratamiento de IVA de un producto. La tasa de GENERAL (16 % u 8 % en región
// fronteriza) sale de Configuración › Impuestos; ZERO y EXEMPT son 0 %, pero
// NO son lo mismo para el SAT (tasa 0 % acredita, exento no): se distinguen
// desde ahora para que el CFDI futuro no requiera reclasificar el catálogo.
enum TaxCategory {
  GENERAL
  ZERO
  EXEMPT
}

enum ShiftStatus {
  OPEN
  CLOSED
  AUDIT_REQUIRED // Si la diferencia es muy grande, se marca para revisión
}

enum CashTransactionType {
  SALE_INCOME // Venta Contado
  CREDIT_PAYMENT // Cliente paga una deuda
  MANUAL_ADD // Ingreso manual
  MANUAL_WITHDRAW // Sangría / Retiro
  REFUND_OUT // Rembolso de salida
  PURCHASE_PAYMENT // Pago a proveedor por mercancía
  REFUND_IN // Proveedor nos devuelve dinero
  EXPENSE // Gasto menor
}

enum TokenType {
  REFRESH // Para refrescar access tokens
  ACCESS // Para acceso a recursos (JWT usualmente)
  VERIFICATION // Para verificar email/cuenta
  PASSWORD_RESET // Para resetear contraseña
  API // Tokens de API de larga duración
}

enum UserRole {
  MANAGER
  ADMIN
  PHARMACIST
  CASHIER
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
}

enum SaleStatus {
  PENDING // Venta registrada pero sin pago
  PARTIAL // Abonada parcialmente
  COMPLETED // Pagada completamente
  CANCELLED
  REFUNDED // Rembolsado
}

enum SaleFlowStatus {
  DRAFT // Venta abierta, editable
  COMPLETED // Venta cerrada (stock ya impactado)
  CANCELLED // Cancelada antes de cerrar
}

enum PurchaseStatus {
  PENDING // Pedido registrado pero no pagado
  PARTIAL // Abonado parcialmente
  PAID // Pagado completamente
  CANCELLED
}

enum PurchaseDeliveryStatus {
  PENDING // Orden creada, mercancía no ha llegado
  RECEIVED // Mercancía recibida e Inventario actualizado (Kardex)
  CANCELLED
}

enum PrintChannel {
  THERMAL
  BROWSER
}

// Qué documento se emitió: ticket térmico o nota de remisión en hoja carta.
// La numeración de copias (original, copia 2…) es POR DOCUMENTO.
enum PrintDocument {
  TICKET
  REMISSION
}

enum ControlledLogEntryType {
  DISPENSE
  RETURN
  DESTRUCTION
}
