# PharmaPOS local — UNA SOLA CAJA (todo en la misma PC).
#
# Copia este archivo a C:\PharmaPOS\caddy\Caddyfile.
# La caja abre http://localhost en Chrome o Edge. `localhost` es un contexto
# seguro para el navegador: funcionan la impresora USB (WebUSB) y las cookies
# seguras sin certificado. Ver docs/produccion/02-LOCAL.md.

http://localhost {
	encode zstd gzip

	@api path /api/* /health /health/*
	handle @api {
		reverse_proxy 127.0.0.1:3005
	}

	handle {
		root * C:/PharmaPOS/web
		# Todo lo que no es un archivo con hash (páginas de la app y el manifiesto
		# de versión) se revalida siempre: así cada caja detecta la versión nueva
		# (ADR-0018). Ojo: `header` evalúa la ruta ORIGINAL, antes de try_files.
		@revalidar expression `!path('/_nuxt/*') || path('/_nuxt/builds/*')`
		header @revalidar Cache-Control "no-cache"
		# Archivos con hash en el nombre: nunca cambian, se cachean un año.
		@inmutables {
			path /_nuxt/*
			not path /_nuxt/builds/*
		}
		header @inmutables Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /200.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
