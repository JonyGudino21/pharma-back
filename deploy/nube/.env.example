# Configuración de PharmaPOS en la nube. Copia este archivo a `.env` (en esta
# misma carpeta) y llena los valores. NUNCA lo subas a GitHub.
#
# Para generar cada secreto, en el servidor:
#   openssl rand -hex 32

# Dominio de la farmacia, ya apuntando a la IP del servidor (registro A).
DOMINIO=farmacia.ejemplo.com.mx

# Contraseña de la base de datos (sólo letras y números: va dentro de una URL).
DB_PASSWORD=

# Secretos de sesión: 64 caracteres cada uno y DISTINTOS entre sí.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Opcionales
# LOG_LEVEL=info
# TOLERANCE_THRESHOLD=20
# FRONT_DIR=../../../pharma-front
# HTTP_PORT=80
# HTTPS_PORT=443
