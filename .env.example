# Plantilla de configuracion. Copiala a `.env` y rellena los valores reales.
# El arranque valida este contrato (src/config/env.validation.ts): si falta algo,
# la aplicacion NO levanta y te dice exactamente que falta.

NODE_ENV=development
PORT=3005

DATABASE_URL="postgresql://usuario:password@localhost:5432/farmacia_db?schema=public"

# Minimo 32 caracteres y DISTINTOS entre si.
# Generar cada uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_DAYS_REMEMBER=7
JWT_REFRESH_DAYS_DEFAULT=1

# Lista blanca de origenes permitidos, separados por comas. Sin comodines.
FRONTEND_URL=http://localhost:3000

# Diferencia maxima tolerada en el arqueo de caja antes de marcar auditoria.
TOLERANCE_THRESHOLD=20

# Rate limiting global (ventana en milisegundos y peticiones permitidas por IP).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=600
