# Plantilla de configuracion. Copiala a `.env` y rellena los valores reales.
# El arranque valida este contrato (src/config/env.validation.ts): si falta algo,
# la aplicacion NO levanta y te dice exactamente que falta.

NODE_ENV=development
PORT=3005
# Interfaz de escucha. En la PC de una farmacia (detras de Caddy): 127.0.0.1,
# para que el puerto 3005 no quede abierto a la red. En Docker: 0.0.0.0.
HOST=0.0.0.0

DATABASE_URL="postgresql://usuario:password@localhost:5432/farmacia_db?schema=public"

# Minimo 32 caracteres y DISTINTOS entre si.
# Generar cada uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_DAYS_REMEMBER=7
JWT_REFRESH_DAYS_DEFAULT=1

# Lista blanca de origenes permitidos, separados por comas. Sin comodines.
FRONTEND_URL=http://localhost:3000

# ── Cookies de sesion ──────────────────────────────────────────────────────
# En produccion COOKIE_SECURE debe ser true (el arranque lo exige). Funciona en
# HTTPS y tambien en http://localhost (el navegador lo trata como seguro).
COOKIE_SECURE=false
# lax: front y API en el MISMO origen (lo recomendado, con Caddy delante).
# none: dominios distintos (exige COOKIE_SECURE=true).
COOKIE_SAME_SITE=lax
# Solo si front y API estan en subdominios distintos del mismo dominio.
COOKIE_DOMAIN=

# true cuando hay un proxy delante (Caddy, Nginx): la IP real del cliente
# llega en X-Forwarded-For (limite de intentos y bitacora de accesos).
TRUST_PROXY=false

# Valor de fabrica: el dia impreso de caducidad todavia se vende. El valor
# vigente se cambia en Configuracion > Inventario.
EXPIRY_INCLUSIVE=true

# Diferencia maxima tolerada en el arqueo de caja antes de marcar auditoria.
TOLERANCE_THRESHOLD=20

# Rate limiting global (ventana en milisegundos y peticiones permitidas por IP).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=600

# Opcional. Por defecto: debug en development, info en production/test.
# En producción debe ser info o warn: debug serializa demasiado y cuesta dinero.
LOG_LEVEL=info

# ── Solo para `npx prisma db seed` (primer administrador y datos de la farmacia)
# En produccion la contrasena debe tener al menos 12 caracteres. Borra estas
# lineas del .env despues de usarlas.
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@farmacia.local
# SEED_ADMIN_USERNAME=admin
# SEED_COMPANY_TRADE_NAME=Mi Farmacia
# SEED_COMPANY_LEGAL_NAME=
# SEED_COMPANY_RFC=
# SEED_COMPANY_ADDRESS=

# ── Solo para scripts/backup.js y scripts/restore.js
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
